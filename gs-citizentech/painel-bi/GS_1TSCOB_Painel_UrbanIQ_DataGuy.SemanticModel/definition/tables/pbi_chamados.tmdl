table pbi_chamados
	lineageTag: addd7d81-54da-4e87-a3dd-12cbc5083062

	/// Chamados de zeladoria abertos no periodo filtrado
	measure 'Total de Chamados' = COUNTROWS(pbi_chamados)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: e0a6c248-d7ae-4771-8143-be5a078b9c26

	measure 'Chamados por Dia' = DIVIDE([Total de Chamados], COUNTROWS(VALUES(pbi_chamados[dt_abertura])))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c18b004b-fc9e-40d4-b163-c2880ecf11bb

	/// Populacao (Censo 2022) das subprefeituras presentes no filtro
	measure Habitantes = CALCULATE(SUM(pbi_subprefeituras[pop_2022]), TREATAS(VALUES(pbi_chamados[subprefeitura]), pbi_subprefeituras[subprefeitura_chave]))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 8822fa73-ef8f-45bf-b27c-775503c132fa

	/// Chamados por 1.000 habitantes no periodo filtrado (6 meses sem filtro de data)
	measure 'Chamados por Mil Hab' = DIVIDE([Total de Chamados], [Habitantes]) * 1000
		formatString: 0.0
		displayFolder: KPIs
		lineageTag: 421ac36f-2341-4288-930e-2ae0bbae4518

	/// Mediana de dias entre abertura e finalizacao (so finalizados)
	measure 'Mediana de Dias' = CALCULATE(MEDIAN(pbi_chamados[dias_atendimento]), pbi_chamados[status] = "Finalizada")
		formatString: 0.0
		displayFolder: KPIs
		lineageTag: ca60ce61-324a-4f8c-9e69-9bad4b4c7077

	measure 'Media de Dias' = CALCULATE(AVERAGE(pbi_chamados[dias_atendimento]), pbi_chamados[status] = "Finalizada")
		formatString: 0.0
		displayFolder: KPIs
		lineageTag: 0fb5341e-2106-4845-8f55-6f713653d942

	measure '% Resolvido em 7 Dias' = DIVIDE(SUM(pbi_chamados[resolvido_7d]), CALCULATE(COUNTROWS(pbi_chamados), pbi_chamados[status] = "Finalizada"))
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: c503a1a9-9144-47c6-9712-a11e379f2d03

	measure '% Em Aberto' = DIVIDE(CALCULATE(COUNTROWS(pbi_chamados), pbi_chamados[status] = "Aberto"), [Total de Chamados])
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: 24a2fe25-07e4-46de-a991-9ad7e89285fa

	/// Fatia dos canais nao digitais/assistidos
	measure '% Telefone ou WhatsApp' = DIVIDE(CALCULATE(COUNTROWS(pbi_chamados), pbi_chamados[canal_nome] IN {"Telefone 156", "WhatsApp"}), CALCULATE(COUNTROWS(pbi_chamados), pbi_chamados[canal_nome] <> "Outros"))
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: 03e4a612-d272-491e-9156-b10110c88eb3

	/// Participacao do canal dentro do contexto (usar no grafico de canal 100%)
	measure '% do Total' = DIVIDE([Total de Chamados], CALCULATE([Total de Chamados], ALLSELECTED(pbi_chamados[canal_nome])))
		formatString: 0.0%
		displayFolder: Apoio
		lineageTag: 497fcc54-0381-4e19-ab08-5ce8a7a01c7e

	/// 0 = territorio que mais pede por habitante; 1 = que menos pede
	measure 'Indice de Subnotificacao' = AVERAGE(pbi_subprefeituras[indice_subnotificacao])
		formatString: 0.00
		displayFolder: KPIs
		lineageTag: ba7ae941-e84c-469a-8bae-aff2effc1342

	measure 'Titulo Dinamico' = "Zeladoria urbana em SP | " & IF(ISFILTERED(pbi_subprefeituras[anel]), CONCATENATEX(VALUES(pbi_subprefeituras[anel]), pbi_subprefeituras[anel], ", "), "Todos os aneis")
		displayFolder: Apoio
		lineageTag: 048be924-67c0-4c31-8c0c-975e866d9bab

	column dt_abertura
		dataType: dateTime
		isHidden
		formatString: Long Date
		lineageTag: ca8fee7a-ffe1-42bd-9a1a-b92922e3f5b6
		summarizeBy: none
		sourceColumn: dt_abertura

		variation Variação
			isDefault
			relationship: c152d718-8d37-4e87-a0cc-ab7aeb70f900
			defaultHierarchy: LocalDateTable_bc70c6c0-edb6-4aad-a57f-9d7e39547a88.'Hierarquia de datas'

