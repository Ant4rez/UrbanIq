                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "color": "#3A4459"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Um canal só digital excluiria quem já pede menos. ",
                    "textStyle": {
                      "fontSize": "11.5pt",
                      "color": "#1E2A4A",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Na periferia, 34% dos pedidos chegam por telefone ou WhatsApp.",
                    "textStyle": {
                      "fontSize": "11.5pt",
                      "color": "#3A4459"
                    }
                  }
                ]
