                      "fontSize": "6pt",
                      "color": "#3A4459"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. A periferia pede 22% menos por habitante. ",
                    "textStyle": {
                      "fontSize": "11.5pt",
                      "color": "#ED185C",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "São 18,6 contra 23,9 pedidos por mil habitantes. Cidade Tiradentes registra menos da metade do que Jabaquara: o problema existe, mas não vira chamado.",
